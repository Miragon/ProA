# Application mode: "web" (auth, multi-user) or "desktop" (single user, no auth).
# Set via `yarn mode web` or `yarn mode desktop` - do not edit manually.
VITE_APP_MODE="web"

# OIDC issuer used in web mode (Keycloak realm URL).
# Defaults to the local dev Keycloak from `make auth-up` (port 8181, realm "proa").
VITE_OIDC_AUTHORITY="http://localhost:8181/realms/proa"

# OIDC client id of the public (PKCE) frontend client in the realm.
VITE_OIDC_CLIENT_ID="proa-frontend"
