  <bpmn:collaboration id="Collaboration_einkauf_bestellfreigabe">
    <bpmn:participant id="Participant_Bestellfreigabe" name="Nordwind Handel – Bestellfreigabe" processRef="Process_Bestellfreigabe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bestellfreigabe" name="Bestellfreigabe" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Mehrstufige Freigabe nach Wertgrenzen gemäß Beschaffungsrichtlinie 2023. Ergebnisvariable freigegeben (Boolean) für die aufrufende Bestellanforderung.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Bestellfreigabe">
      <bpmn:lane id="Lane_Einkauf" name="Einkauf">
        <bpmn:flowNodeRef>Start_FreigabeAngefordert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FreigabestufeErmitteln</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UeberKleinbetrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Freigabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FreigabeDokumentieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BestellungFreigegeben</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Abteilungsleitung" name="Abteilungsleitung">
        <bpmn:flowNodeRef>Gateway_UeberGfGrenze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruefungAbteilungsleitung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Genehmigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BestellungAbgelehnt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Geschaeftsfuehrung" name="Geschäftsführung">
        <bpmn:flowNodeRef>Task_PruefungGeschaeftsfuehrung</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_FreigabeAngefordert" name="Freigabe angefordert">
      <bpmn:outgoing>Flow_Start_FreigabeAngefordert_Task_FreigabestufeErmitteln</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_FreigabestufeErmitteln" name="Freigabestufe ermitteln" camunda:type="external" camunda:topic="freigabestufe-ermitteln">
      <bpmn:documentation>Bestellungen bis 5.000 EUR sind ohne Prüfung freigegeben (freigegeben = true).</bpmn:documentation>
      <bpmn:incoming>Flow_Start_FreigabeAngefordert_Task_FreigabestufeErmitteln</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FreigabestufeErmitteln_Gateway_UeberKleinbetrag</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_UeberKleinbetrag" name="Bestellwert über 5.000 EUR?" default="Flow_Gateway_UeberKleinbetrag_Gateway_Freigabe">
      <bpmn:incoming>Flow_Task_FreigabestufeErmitteln_Gateway_UeberKleinbetrag</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_UeberKleinbetrag_Gateway_Freigabe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_UeberKleinbetrag_Gateway_UeberGfGrenze</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_UeberGfGrenze" name="Bestellwert über 50.000 EUR?" default="Flow_Gateway_UeberGfGrenze_Task_PruefungAbteilungsleitung">
      <bpmn:incoming>Flow_Gateway_UeberKleinbetrag_Gateway_UeberGfGrenze</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_UeberGfGrenze_Task_PruefungGeschaeftsfuehrung</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_UeberGfGrenze_Task_PruefungAbteilungsleitung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PruefungAbteilungsleitung" name="Bestellung prüfen (Abteilungsleitung)" camunda:candidateGroups="abteilungsleitung">
      <bpmn:incoming>Flow_Gateway_UeberGfGrenze_Task_PruefungAbteilungsleitung</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PruefungAbteilungsleitung_Gateway_Entscheidung</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PruefungGeschaeftsfuehrung" name="Bestellung prüfen (Geschäftsführung)" camunda:candidateGroups="geschaeftsfuehrung">
      <bpmn:incoming>Flow_Gateway_UeberGfGrenze_Task_PruefungGeschaeftsfuehrung</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PruefungGeschaeftsfuehrung_Gateway_Entscheidung</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Entscheidung">
      <bpmn:incoming>Flow_Task_PruefungAbteilungsleitung_Gateway_Entscheidung</bpmn:incoming>
