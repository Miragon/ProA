    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_FreigabeAngefordert_Task_FreigabestufeErmitteln" sourceRef="Start_FreigabeAngefordert" targetRef="Task_FreigabestufeErmitteln" />
    <bpmn:sequenceFlow id="Flow_Task_FreigabestufeErmitteln_Gateway_UeberKleinbetrag" sourceRef="Task_FreigabestufeErmitteln" targetRef="Gateway_UeberKleinbetrag" />
    <bpmn:sequenceFlow id="Flow_Gateway_UeberKleinbetrag_Gateway_Freigabe" name="nein" sourceRef="Gateway_UeberKleinbetrag" targetRef="Gateway_Freigabe" />
    <bpmn:sequenceFlow id="Flow_Gateway_UeberKleinbetrag_Gateway_UeberGfGrenze" name="ja" sourceRef="Gateway_UeberKleinbetrag" targetRef="Gateway_UeberGfGrenze">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellwert &gt; 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_UeberGfGrenze_Task_PruefungGeschaeftsfuehrung" name="ja" sourceRef="Gateway_UeberGfGrenze" targetRef="Task_PruefungGeschaeftsfuehrung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellwert &gt; 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_UeberGfGrenze_Task_PruefungAbteilungsleitung" name="nein" sourceRef="Gateway_UeberGfGrenze" targetRef="Task_PruefungAbteilungsleitung" />
    <bpmn:sequenceFlow id="Flow_Task_PruefungAbteilungsleitung_Gateway_Entscheidung" sourceRef="Task_PruefungAbteilungsleitung" targetRef="Gateway_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_Task_PruefungGeschaeftsfuehrung_Gateway_Entscheidung" sourceRef="Task_PruefungGeschaeftsfuehrung" targetRef="Gateway_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_Gateway_Entscheidung_Gateway_Genehmigt" sourceRef="Gateway_Entscheidung" targetRef="Gateway_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Gateway_Genehmigt_End_BestellungAbgelehnt" name="nein" sourceRef="Gateway_Genehmigt" targetRef="End_BestellungAbgelehnt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!freigegeben}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Genehmigt_Gateway_Freigabe" sourceRef="Gateway_Genehmigt" targetRef="Gateway_Freigabe" />
    <bpmn:sequenceFlow id="Flow_Gateway_Freigabe_Task_FreigabeDokumentieren" sourceRef="Gateway_Freigabe" targetRef="Task_FreigabeDokumentieren" />
    <bpmn:sequenceFlow id="Flow_Task_FreigabeDokumentieren_End_BestellungFreigegeben" sourceRef="Task_FreigabeDokumentieren" targetRef="End_BestellungFreigegeben" />
  </bpmn:process>
