      <bpmn:outgoing>Flow_Gateway_Entscheidung_Gateway_Genehmigt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Genehmigt" name="Genehmigt?" default="Flow_Gateway_Genehmigt_Gateway_Freigabe">
      <bpmn:incoming>Flow_Gateway_Entscheidung_Gateway_Genehmigt</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Genehmigt_End_BestellungAbgelehnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Genehmigt_Gateway_Freigabe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Freigabe">
      <bpmn:incoming>Flow_Gateway_UeberKleinbetrag_Gateway_Freigabe</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Genehmigt_Gateway_Freigabe</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Freigabe_Task_FreigabeDokumentieren</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FreigabeDokumentieren" name="Freigabe dokumentieren" camunda:type="external" camunda:topic="freigabe-dokumentieren">
      <bpmn:incoming>Flow_Gateway_Freigabe_Task_FreigabeDokumentieren</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FreigabeDokumentieren_End_BestellungFreigegeben</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_BestellungFreigegeben" name="Bestellung freigegeben">
      <bpmn:incoming>Flow_Task_FreigabeDokumentieren_End_BestellungFreigegeben</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_BestellungAbgelehnt" name="Bestellung abgelehnt">
