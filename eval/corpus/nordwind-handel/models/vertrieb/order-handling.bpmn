        <bpmn:incoming>Flow_Start_OrderCancelled_Task_CancelOrder</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_CancelOrder_End_OrderCancelled</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_OrderCancelled" name="Order cancellation processed">
        <bpmn:incoming>Flow_Task_CancelOrder_End_OrderCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_OrderCancelled_Task_CancelOrder" sourceRef="Start_OrderCancelled" targetRef="Task_CancelOrder" />
      <bpmn:sequenceFlow id="Flow_Task_CancelOrder_End_OrderCancelled" sourceRef="Task_CancelOrder" targetRef="End_OrderCancelled" />
    </bpmn:subProcess>
    <bpmn:dataStoreReference id="DataStore_CustomerMaster" name="Customer master" />
    <bpmn:sequenceFlow id="Flow_Start_OrderReceived_Task_ValidateOrder" sourceRef="Start_OrderReceived" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Task_ValidateOrder_Call_FraudCheck" sourceRef="Task_ValidateOrder" targetRef="Call_FraudCheck" />
