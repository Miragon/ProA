  </bpmn:collaboration>
  <bpmn:process id="Process_OrderHandling" name="Order handling" isExecutable="true">
    <bpmn:documentation>Handles shop and marketplace orders from receipt to payment: validation, fraud and credit checks, picking, parcel shipping and payment tracking.</bpmn:documentation>
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_Start_OrderReceived_Task_ValidateOrder</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_OrderReceived_ed" messageRef="Message_OrderReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_OrderReceived_Task_ValidateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ValidateOrder_Call_FraudCheck</bpmn:outgoing>
      <bpmn:property id="Property_Task_ValidateOrder" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Task_ValidateOrder_DataStore_CustomerMaster">
        <bpmn:sourceRef>DataStore_CustomerMaster</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_ValidateOrder</bpmn:targetRef>
      </bpmn:dataInputAssociation>
