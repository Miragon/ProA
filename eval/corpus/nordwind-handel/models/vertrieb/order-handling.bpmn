      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_ValidateOrder_Call_FraudCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_FraudCheck_Gateway_OnAccount</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_OnAccount" name="Purchase on account?" default="Flow_Gateway_OnAccount_Gateway_CreditChecked">
      <bpmn:incoming>Flow_Call_FraudCheck_Gateway_OnAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_OnAccount_Task_RequestCreditCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_OnAccount_Gateway_CreditChecked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestCreditCheck" name="Request credit check" messageRef="Message_KreditpruefungAngefordert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-credit-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_OnAccount_Task_RequestCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RequestCreditCheck_Task_WaitForCreditDecision</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitForCreditDecision" name="Wait for credit decision" messageRef="Message_KreditpruefungAbgeschlossen">
      <bpmn:incoming>Flow_Task_RequestCreditCheck_Task_WaitForCreditDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_WaitForCreditDecision_Gateway_CreditApproved</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_CreditApproved" name="Credit approved?" default="Flow_Gateway_CreditApproved_Task_SendRejection">
      <bpmn:incoming>Flow_Task_WaitForCreditDecision_Gateway_CreditApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CreditApproved_Gateway_CreditChecked</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_CreditApproved_Task_SendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CreditChecked">
      <bpmn:incoming>Flow_Gateway_OnAccount_Gateway_CreditChecked</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_CreditApproved_Gateway_CreditChecked</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CreditChecked_Task_SendConfirmation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send order confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_CreditChecked_Task_SendConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SendConfirmation_Call_PickAndPack</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:callActivity id="Call_PickAndPack" name="Pick and pack">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Kommissionierung" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_SendConfirmation_Call_PickAndPack</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_PickAndPack_Gateway_FreightForwarder</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_FreightForwarder" name="Pallet freight?" default="Flow_Gateway_FreightForwarder_Call_ShipOrder">
      <bpmn:incoming>Flow_Call_PickAndPack_Gateway_FreightForwarder</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_FreightForwarder_Gateway_Shipped</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_FreightForwarder_Call_ShipOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_ShipOrder" name="Ship parcel">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Shipping" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_FreightForwarder_Call_ShipOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_ShipOrder_Gateway_Shipped</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_Shipped">
      <bpmn:incoming>Flow_Gateway_FreightForwarder_Gateway_Shipped</bpmn:incoming>
      <bpmn:incoming>Flow_Call_ShipOrder_Gateway_Shipped</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Shipped_Gateway_AwaitPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AwaitPayment" name="Payment outstanding?" default="Flow_Gateway_AwaitPayment_Gateway_Paid">
      <bpmn:incoming>Flow_Gateway_Shipped_Gateway_AwaitPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AwaitPayment_Event_PaymentAllocated</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_AwaitPayment_Gateway_Paid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_PaymentAllocated" name="Payment allocated">
      <bpmn:incoming>Flow_Gateway_AwaitPayment_Event_PaymentAllocated</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_PaymentAllocated_Gateway_Paid</bpmn:outgoing>
