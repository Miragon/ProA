    <bpmn:sequenceFlow id="Flow_Gateway_OnAccount_Task_RequestCreditCheck" name="yes" sourceRef="Gateway_OnAccount" targetRef="Task_RequestCreditCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=onAccount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_OnAccount_Gateway_CreditChecked" name="no" sourceRef="Gateway_OnAccount" targetRef="Gateway_CreditChecked" />
    <bpmn:sequenceFlow id="Flow_Task_RequestCreditCheck_Task_WaitForCreditDecision" sourceRef="Task_RequestCreditCheck" targetRef="Task_WaitForCreditDecision" />
    <bpmn:sequenceFlow id="Flow_Task_WaitForCreditDecision_Gateway_CreditApproved" sourceRef="Task_WaitForCreditDecision" targetRef="Gateway_CreditApproved" />
    <bpmn:sequenceFlow id="Flow_Gateway_CreditApproved_Gateway_CreditChecked" name="yes" sourceRef="Gateway_CreditApproved" targetRef="Gateway_CreditChecked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_CreditApproved_Task_SendRejection" name="no" sourceRef="Gateway_CreditApproved" targetRef="Task_SendRejection" />
    <bpmn:sequenceFlow id="Flow_Gateway_CreditChecked_Task_SendConfirmation" sourceRef="Gateway_CreditChecked" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_Task_SendConfirmation_Call_PickAndPack" sourceRef="Task_SendConfirmation" targetRef="Call_PickAndPack" />
    <bpmn:sequenceFlow id="Flow_Call_PickAndPack_Gateway_FreightForwarder" sourceRef="Call_PickAndPack" targetRef="Gateway_FreightForwarder" />
    <bpmn:sequenceFlow id="Flow_Gateway_FreightForwarder_Gateway_Shipped" name="yes" sourceRef="Gateway_FreightForwarder" targetRef="Gateway_Shipped">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=shippingMode = "freight"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_FreightForwarder_Call_ShipOrder" name="no" sourceRef="Gateway_FreightForwarder" targetRef="Call_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_Call_ShipOrder_Gateway_Shipped" sourceRef="Call_ShipOrder" targetRef="Gateway_Shipped" />
    <bpmn:sequenceFlow id="Flow_Gateway_Shipped_Gateway_AwaitPayment" sourceRef="Gateway_Shipped" targetRef="Gateway_AwaitPayment" />
    <bpmn:sequenceFlow id="Flow_Gateway_AwaitPayment_Event_PaymentAllocated" name="yes" sourceRef="Gateway_AwaitPayment" targetRef="Event_PaymentAllocated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=onAccount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_AwaitPayment_Gateway_Paid" name="no" sourceRef="Gateway_AwaitPayment" targetRef="Gateway_Paid" />
    <bpmn:sequenceFlow id="Flow_Event_PaymentAllocated_Gateway_Paid" sourceRef="Event_PaymentAllocated" targetRef="Gateway_Paid" />
    <bpmn:sequenceFlow id="Flow_Gateway_Paid_End_OrderCompleted" sourceRef="Gateway_Paid" targetRef="End_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_Task_SendRejection_End_OrderRejected" sourceRef="Task_SendRejection" targetRef="End_OrderRejected" />
  </bpmn:process>
