    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Paid">
      <bpmn:incoming>Flow_Gateway_AwaitPayment_Gateway_Paid</bpmn:incoming>
      <bpmn:incoming>Flow_Event_PaymentAllocated_Gateway_Paid</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Paid_End_OrderCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OrderCompleted" name="Order completed">
      <bpmn:incoming>Flow_Gateway_Paid_End_OrderCompleted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_CreditApproved_Task_SendRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SendRejection_End_OrderRejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_Task_SendRejection_End_OrderRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="EventSub_InvoiceSent" name="Invoice sent" triggeredByEvent="true">
      <bpmn:startEvent id="Start_InvoiceSent" name="Invoice sent" isInterrupting="false">
        <bpmn:outgoing>Flow_Start_InvoiceSent_Task_SetStatusInvoiced</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Start_InvoiceSent_ed" messageRef="Message_InvoiceSent" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_SetStatusInvoiced" name="Set order status to invoiced">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="set-status-invoiced" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Start_InvoiceSent_Task_SetStatusInvoiced</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_SetStatusInvoiced_End_StatusInvoiced</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_StatusInvoiced" name="Order status set to invoiced">
        <bpmn:incoming>Flow_Task_SetStatusInvoiced_End_StatusInvoiced</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_InvoiceSent_Task_SetStatusInvoiced" sourceRef="Start_InvoiceSent" targetRef="Task_SetStatusInvoiced" />
      <bpmn:sequenceFlow id="Flow_Task_SetStatusInvoiced_End_StatusInvoiced" sourceRef="Task_SetStatusInvoiced" targetRef="End_StatusInvoiced" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSub_ProductRecall" name="Product recall" triggeredByEvent="true">
      <bpmn:startEvent id="Start_ProductRecall" name="Product recall" isInterrupting="false">
        <bpmn:outgoing>Flow_Start_ProductRecall_Task_CheckOrderForRecall</bpmn:outgoing>
        <bpmn:signalEventDefinition id="Start_ProductRecall_ed" signalRef="Signal_Produktrueckruf" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_CheckOrderForRecall" name="Check order for recalled items">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="check-order-for-recall" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Start_ProductRecall_Task_CheckOrderForRecall</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_CheckOrderForRecall_End_OrderCheckedForRecall</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_OrderCheckedForRecall" name="Order checked for recall">
        <bpmn:incoming>Flow_Task_CheckOrderForRecall_End_OrderCheckedForRecall</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_ProductRecall_Task_CheckOrderForRecall" sourceRef="Start_ProductRecall" targetRef="Task_CheckOrderForRecall" />
      <bpmn:sequenceFlow id="Flow_Task_CheckOrderForRecall_End_OrderCheckedForRecall" sourceRef="Task_CheckOrderForRecall" targetRef="End_OrderCheckedForRecall" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSub_OrderCancelled" name="Order cancelled" triggeredByEvent="true">
      <bpmn:startEvent id="Start_OrderCancelled" name="Order cancelled">
        <bpmn:outgoing>Flow_Start_OrderCancelled_Task_CancelOrder</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Start_OrderCancelled_ed" messageRef="Message_OrderCancelled" />
