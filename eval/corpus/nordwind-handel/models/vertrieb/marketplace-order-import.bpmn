  <bpmn:process id="Process_MarketplaceOrderImport" name="Marketplace order import" isExecutable="true">
    <bpmn:documentation>Imports orders from online marketplaces, maps them to the Nordwind order format and forwards them to the shop.</bpmn:documentation>
    <bpmn:startEvent id="Start_MarketplaceOrderNotified" name="Marketplace order notified">
      <bpmn:outgoing>Flow_Start_MarketplaceOrderNotified_Task_FetchOrderDetails</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_MarketplaceOrderNotified_ed" messageRef="Message_MarketplaceOrderNotified" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchOrderDetails" name="Fetch order details from marketplace">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-order-details" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_MarketplaceOrderNotified_Task_FetchOrderDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FetchOrderDetails_Task_MapOrder</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MapOrder" name="Map to Nordwind order format">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="map-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_FetchOrderDetails_Task_MapOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_MapOrder_Task_CheckMarketplaceRules</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_CheckMarketplaceRules" name="Check marketplace rules">
