        <zeebe:taskDefinition type="check-marketplace-rules" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_MapOrder_Task_CheckMarketplaceRules</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CheckMarketplaceRules_Gateway_OrderValid</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Order valid?" default="Flow_Gateway_OrderValid_End_OrderRejected">
      <bpmn:incoming>Flow_Task_CheckMarketplaceRules_Gateway_OrderValid</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_OrderValid_Event_ForwardOrder</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_OrderValid_End_OrderRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_ForwardOrder" name="Order forwarded to shop">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="forward-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_OrderValid_Event_ForwardOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_ForwardOrder_End_OrderImported</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_ForwardOrder_ed" messageRef="Message_OrderReceived" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_OrderImported" name="Order imported">
      <bpmn:incoming>Flow_Event_ForwardOrder_End_OrderImported</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OrderRejected" name="Order rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-rejected" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_OrderValid_End_OrderRejected</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_OrderRejected_ed" messageRef="Message_OrderRejected" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_MarketplaceOrderNotified_Task_FetchOrderDetails" sourceRef="Start_MarketplaceOrderNotified" targetRef="Task_FetchOrderDetails" />
    <bpmn:sequenceFlow id="Flow_Task_FetchOrderDetails_Task_MapOrder" sourceRef="Task_FetchOrderDetails" targetRef="Task_MapOrder" />
    <bpmn:sequenceFlow id="Flow_Task_MapOrder_Task_CheckMarketplaceRules" sourceRef="Task_MapOrder" targetRef="Task_CheckMarketplaceRules" />
    <bpmn:sequenceFlow id="Flow_Task_CheckMarketplaceRules_Gateway_OrderValid" sourceRef="Task_CheckMarketplaceRules" targetRef="Gateway_OrderValid" />
    <bpmn:sequenceFlow id="Flow_Gateway_OrderValid_Event_ForwardOrder" name="yes" sourceRef="Gateway_OrderValid" targetRef="Event_ForwardOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_OrderValid_End_OrderRejected" name="no" sourceRef="Gateway_OrderValid" targetRef="End_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_Event_ForwardOrder_End_OrderImported" sourceRef="Event_ForwardOrder" targetRef="End_OrderImported" />
  </bpmn:process>
