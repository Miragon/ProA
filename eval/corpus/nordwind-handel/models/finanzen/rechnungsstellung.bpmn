    <bpmn:subProcess id="EventSub_BuchungsperiodeGesperrt" name="Buchungsperiode gesperrt" triggeredByEvent="true">
      <bpmn:startEvent id="Start_BuchungsperiodeGesperrt" name="Buchungsperiode gesperrt" isInterrupting="false">
        <bpmn:outgoing>Flow_Start_BuchungsperiodeGesperrt_Task_RechnungsdatumVerschieben</bpmn:outgoing>
        <bpmn:signalEventDefinition id="Start_BuchungsperiodeGesperrt_ed" signalRef="Signal_BuchungsperiodeGesperrt" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_RechnungsdatumVerschieben" name="Rechnungsdatum auf Folgeperiode setzen" camunda:type="external" camunda:topic="rechnungsdatum-verschieben">
        <bpmn:incoming>Flow_Start_BuchungsperiodeGesperrt_Task_RechnungsdatumVerschieben</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_RechnungsdatumVerschieben_End_RechnungsdatumVerschoben</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_RechnungsdatumVerschoben" name="Rechnungsdatum verschoben">
        <bpmn:incoming>Flow_Task_RechnungsdatumVerschieben_End_RechnungsdatumVerschoben</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_BuchungsperiodeGesperrt_Task_RechnungsdatumVerschieben" sourceRef="Start_BuchungsperiodeGesperrt" targetRef="Task_RechnungsdatumVerschieben" />
      <bpmn:sequenceFlow id="Flow_Task_RechnungsdatumVerschieben_End_RechnungsdatumVerschoben" sourceRef="Task_RechnungsdatumVerschieben" targetRef="End_RechnungsdatumVerschoben" />
    </bpmn:subProcess>
