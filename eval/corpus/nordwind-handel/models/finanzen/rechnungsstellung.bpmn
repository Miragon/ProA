    <bpmn:sequenceFlow id="Flow_Gateway_Kostenpflichtig_End_KeineRechnungErforderlich" name="nein, Ersatzlieferung" sourceRef="Gateway_Kostenpflichtig" targetRef="End_KeineRechnungErforderlich">
