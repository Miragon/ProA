  <bpmn:process id="Process_Rechnungsstellung" name="Rechnungsstellung" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Erstellt nach dem Versand die Ausgangsrechnung, gibt sie über den vom Kunden gewählten Kanal (E-Rechnung oder Brief) aus und meldet den Versand der Rechnung.</bpmn:documentation>
    <bpmn:startEvent id="Start_LieferungVersendet" name="Lieferung versendet">
      <bpmn:outgoing>Flow_Start_LieferungVersendet_Task_AuftragsdatenLaden</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_LieferungVersendet_ed" messageRef="Message_LieferungVersendet" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_AuftragsdatenLaden" name="Auftrags- und Kundendaten laden" camunda:type="external" camunda:topic="auftragsdaten-laden">
      <bpmn:incoming>Flow_Start_LieferungVersendet_Task_AuftragsdatenLaden</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AuftragsdatenLaden_Gateway_Kostenpflichtig</bpmn:outgoing>
      <bpmn:property id="Property_Task_AuftragsdatenLaden" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Task_AuftragsdatenLaden_DataStore_Kundenstamm">
        <bpmn:sourceRef>DataStore_Kundenstamm</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_AuftragsdatenLaden</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Kostenpflichtig" name="Kostenpflichtige Lieferung?" default="Flow_Gateway_Kostenpflichtig_Task_SteuersatzErmitteln">
      <bpmn:incoming>Flow_Task_AuftragsdatenLaden_Gateway_Kostenpflichtig</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Kostenpflichtig_Task_SteuersatzErmitteln</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Kostenpflichtig_End_KeineRechnungErforderlich</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_SteuersatzErmitteln" name="Steuersatz und Zahlungsziel ermitteln" camunda:type="external" camunda:topic="steuersatz-ermitteln">
      <bpmn:incoming>Flow_Gateway_Kostenpflichtig_Task_SteuersatzErmitteln</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SteuersatzErmitteln_Gateway_Sammelrechnung</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Sammelrechnung" name="Sammelrechnung vereinbart?" default="Flow_Gateway_Sammelrechnung_Task_RechnungErzeugen">
      <bpmn:incoming>Flow_Task_SteuersatzErmitteln_Gateway_Sammelrechnung</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Sammelrechnung_Task_AufSammelrechnungVormerken</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Sammelrechnung_Task_RechnungErzeugen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AufSammelrechnungVormerken" name="Auf Sammelrechnung vormerken" camunda:type="external" camunda:topic="auf-sammelrechnung-vormerken">
      <bpmn:incoming>Flow_Gateway_Sammelrechnung_Task_AufSammelrechnungVormerken</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AufSammelrechnungVormerken_End_FuerSammelrechnungVorgemerkt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_FuerSammelrechnungVorgemerkt" name="Für Sammelrechnung vorgemerkt">
      <bpmn:incoming>Flow_Task_AufSammelrechnungVormerken_End_FuerSammelrechnungVorgemerkt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RechnungErzeugen" name="Rechnung erzeugen und buchen" camunda:type="external" camunda:topic="rechnung-erzeugen">
      <bpmn:incoming>Flow_Gateway_Sammelrechnung_Task_RechnungErzeugen</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RechnungErzeugen_Call_RechnungAusgeben</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Task_RechnungErzeugen_DataStore_Hauptbuch">
        <bpmn:targetRef>DataStore_Hauptbuch</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_RechnungAusgeben" name="Rechnung über Ausgabekanal versenden" calledElement="${ausgabekanal}">
      <bpmn:documentation>ausgabekanal ist Process_ERechnungVersand oder Process_Briefversand, je nach Kundeneinstellung.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_RechnungErzeugen_Call_RechnungAusgeben</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_RechnungAusgeben_Event_RechnungVersendet</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateThrowEvent id="Event_RechnungVersendet" name="Rechnung versendet">
      <bpmn:incoming>Flow_Call_RechnungAusgeben_Event_RechnungVersendet</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_RechnungVersendet_End_RechnungGestellt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_RechnungVersendet_ed" messageRef="Message_RechnungVersendet" camunda:type="external" camunda:topic="rechnung-versendet" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_RechnungGestellt" name="Rechnung gestellt">
      <bpmn:incoming>Flow_Event_RechnungVersendet_End_RechnungGestellt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_KeineRechnungErforderlich" name="Keine Rechnung erforderlich">
