    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_MahnstufeErmitteln" name="Mahnstufe und Mahngebühr ermitteln" camunda:type="external" camunda:topic="mahnstufe-ermitteln">
