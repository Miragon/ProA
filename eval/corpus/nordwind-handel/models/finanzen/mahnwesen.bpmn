  <bpmn:process id="Process_Mahnwesen" name="Mahnwesen" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Durchläuft bis zu drei Mahnstufen und sperrt den Kunden nach der letzten Stufe. Ergebnisvariable beglichen (Boolean) für das aufrufende Forderungsmanagement.</bpmn:documentation>
    <bpmn:startEvent id="Start_MahnverfahrenGestartet" name="Mahnverfahren gestartet">
      <bpmn:outgoing>Flow_Start_MahnverfahrenGestartet_Gateway_NaechsteStufe</bpmn:outgoing>
