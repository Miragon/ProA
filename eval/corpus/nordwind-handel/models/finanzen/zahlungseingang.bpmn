  <bpmn:process id="Process_Zahlungseingang" name="Zahlungseingang" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Ruft werktags den Kontoauszug ab, ordnet Zahlungen den offenen Posten zu und meldet die Zuordnung. Rücklastschriften werden nicht hier, sondern über den R-Transaktions-Import verarbeitet.</bpmn:documentation>
    <bpmn:startEvent id="Start_KontoauszugFaellig" name="Werktags 6 Uhr">
      <bpmn:outgoing>Flow_Start_KontoauszugFaellig_Task_KontoauszugAbrufen</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Start_KontoauszugFaellig_ed">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 6 ? * MON-FRI</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_KontoauszugAbrufen" name="Kontoauszug abrufen (camt.053)" camunda:type="external" camunda:topic="kontoauszug-abrufen">
