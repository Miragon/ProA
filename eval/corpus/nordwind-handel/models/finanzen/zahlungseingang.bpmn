        <bpmn:sourceRef>DataStore_OpListe</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_ZahlungenZuordnen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
