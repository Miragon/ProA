      <bpmn:outgoing>Flow_Task_KontoauszugAbrufen_Task_ZahlungenZuordnen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ZahlungenZuordnen" name="Zahlungen automatisch zuordnen" camunda:type="external" camunda:topic="zahlungen-zuordnen">
