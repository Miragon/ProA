  <bpmn:process id="Process_Wareneingang" name="Wareneingang" isExecutable="true">
    <bpmn:documentation>Avisiert erwartete Lieferungen, nimmt Ware an, lässt sie stichprobenartig prüfen, bucht freigegebene Ware und lagert sie ein; gesperrte Ware geht an den Lieferanten zurück.</bpmn:documentation>
    <bpmn:startEvent id="Start_BestellungAusgeloest" name="Bestellung ausgelöst">
