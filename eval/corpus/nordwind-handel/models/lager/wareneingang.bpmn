      <bpmn:timerEventDefinition id="Boundary_LieferungUeberfaellig_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_QsBestandBuchen" name="Ware in Qualitätsprüfbestand buchen">
      <bpmn:documentation>Die Ware ist erfasst, aber bis zur Freigabe nicht verfügbar.</bpmn:documentation>
