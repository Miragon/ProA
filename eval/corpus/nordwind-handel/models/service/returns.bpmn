    </bpmn:subProcess>
    <bpmn:dataStoreReference id="DataStore_Inventory" name="Inventory" />
    <bpmn:sequenceFlow id="Flow_Start_ReturnRequested_Task_CreateReturnLabel" sourceRef="Start_ReturnRequested" targetRef="Task_CreateReturnLabel" />
    <bpmn:sequenceFlow id="Flow_Task_CreateReturnLabel_Task_InspectReturnedGoods" sourceRef="Task_CreateReturnLabel" targetRef="Task_InspectReturnedGoods" />
    <bpmn:sequenceFlow id="Flow_Task_InspectReturnedGoods_Gateway_Resellable" sourceRef="Task_InspectReturnedGoods" targetRef="Gateway_Resellable" />
