  <bpmn:process id="Process_Returns" name="Returns" isExecutable="true">
    <bpmn:documentation>Issues return labels, inspects returned goods, restocks them and settles the return by refund or exchange.</bpmn:documentation>
    <bpmn:startEvent id="Start_ReturnRequested" name="Return requested">
      <bpmn:outgoing>Flow_Start_ReturnRequested_Task_CreateReturnLabel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_ReturnRequested_ed" messageRef="Message_ReturnRequested" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateReturnLabel" name="Create return label">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-return-label" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_ReturnRequested_Task_CreateReturnLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CreateReturnLabel_Task_InspectReturnedGoods</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InspectReturnedGoods" name="Receive and inspect returned goods">
      <bpmn:extensionElements>
        <zeebe:formDefinition externalReference="custom:inspect-returned-goods" />
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="returns-desk" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_CreateReturnLabel_Task_InspectReturnedGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_InspectReturnedGoods_Gateway_Resellable</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_NoParcel" name="No parcel after 14 days" attachedToRef="Task_InspectReturnedGoods">
      <bpmn:outgoing>Flow_Boundary_NoParcel_End_ReturnExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_NoParcel_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_Resellable" name="Goods resellable?" default="Flow_Gateway_Resellable_Gateway_Restocked">
      <bpmn:incoming>Flow_Task_InspectReturnedGoods_Gateway_Resellable</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Resellable_Task_RestockGoods</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Resellable_Gateway_Restocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RestockGoods" name="Restock goods">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="restock-goods" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Resellable_Task_RestockGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RestockGoods_Gateway_Restocked</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Task_RestockGoods_DataStore_Inventory">
        <bpmn:targetRef>DataStore_Inventory</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Restocked">
      <bpmn:incoming>Flow_Gateway_Resellable_Gateway_Restocked</bpmn:incoming>
      <bpmn:incoming>Flow_Task_RestockGoods_Gateway_Restocked</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Restocked_Gateway_Resolution</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Resolution" name="Refund or exchange?" default="Flow_Gateway_Resolution_Task_RequestCreditNote">
      <bpmn:incoming>Flow_Gateway_Restocked_Gateway_Resolution</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Resolution_Task_RequestCreditNote</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Resolution_Call_ShipExchangeItem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestCreditNote" name="Request credit note" messageRef="Message_CreditNoteRequested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-credit-note" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Resolution_Task_RequestCreditNote</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RequestCreditNote_Task_AwaitCreditNote</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitCreditNote" name="Await credit note" messageRef="Message_GutschriftErstellt">
      <bpmn:incoming>Flow_Task_RequestCreditNote_Task_AwaitCreditNote</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AwaitCreditNote_Gateway_Settled</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:callActivity id="Call_ShipExchangeItem" name="Ship exchange item">
      <bpmn:documentation>exchangeProcess is set per sales channel at runtime; shop orders get a free-of-charge replacement order that is picked and shipped as a parcel.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=exchangeProcess" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Resolution_Call_ShipExchangeItem</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_ShipExchangeItem_Gateway_Settled</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_Settled">
      <bpmn:incoming>Flow_Task_AwaitCreditNote_Gateway_Settled</bpmn:incoming>
      <bpmn:incoming>Flow_Call_ShipExchangeItem_Gateway_Settled</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Settled_End_ReturnCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ReturnCompleted" name="Return completed">
