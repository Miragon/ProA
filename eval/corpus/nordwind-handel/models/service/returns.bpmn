    <bpmn:sequenceFlow id="Flow_Gateway_Resellable_Task_RestockGoods" name="yes" sourceRef="Gateway_Resellable" targetRef="Task_RestockGoods">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resellable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Resellable_Gateway_Restocked" name="no" sourceRef="Gateway_Resellable" targetRef="Gateway_Restocked" />
    <bpmn:sequenceFlow id="Flow_Task_RestockGoods_Gateway_Restocked" sourceRef="Task_RestockGoods" targetRef="Gateway_Restocked" />
