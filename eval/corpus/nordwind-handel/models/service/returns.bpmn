      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_FlagRecallCase" name="Flag return as recall case">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="flag-recall-case" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Start_ProductRecall_Task_FlagRecallCase</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_FlagRecallCase_End_RecallCaseFlagged</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_RecallCaseFlagged" name="Return flagged as recall case">
        <bpmn:incoming>Flow_Task_FlagRecallCase_End_RecallCaseFlagged</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_ProductRecall_Task_FlagRecallCase" sourceRef="Start_ProductRecall" targetRef="Task_FlagRecallCase" />
