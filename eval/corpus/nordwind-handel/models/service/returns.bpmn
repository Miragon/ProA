    <bpmn:sequenceFlow id="Flow_Gateway_Resolution_Task_RequestCreditNote" name="refund" sourceRef="Gateway_Resolution" targetRef="Task_RequestCreditNote" />
    <bpmn:sequenceFlow id="Flow_Gateway_Resolution_Call_ShipExchangeItem" name="exchange" sourceRef="Gateway_Resolution" targetRef="Call_ShipExchangeItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resolution = "exchange"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_RequestCreditNote_Task_AwaitCreditNote" sourceRef="Task_RequestCreditNote" targetRef="Task_AwaitCreditNote" />
