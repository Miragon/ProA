<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by eval/tools/generate.mjs from eval/corpus/nordwind-handel/spec/partner/partner-onboarding.yaml. Do not edit; change the spec and regenerate. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_partner_partner_onboarding" name="Dealer onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProA eval generator" exporterVersion="1.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_PartnerOnboarding" name="Dealer onboarding" isExecutable="true">
    <bpmn:documentation>Onboards new B2B dealers, from application through register, document and credit checks to an active customer account.</bpmn:documentation>
    <bpmn:startEvent id="Start_DealerApplicationReceived" name="Dealer application received">
      <bpmn:outgoing>Flow_Start_DealerApplicationReceived_Task_VerifyCommercialRegister</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_VerifyCommercialRegister" name="Verify commercial register entry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-commercial-register" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_DealerApplicationReceived_Task_VerifyCommercialRegister</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VerifyCommercialRegister_Task_CheckDocuments</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CheckDocuments" name="Check trade licence and documents">
      <bpmn:extensionElements>
        <zeebe:formDefinition externalReference="custom:check-documents" />
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="partner-management" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_VerifyCommercialRegister_Task_CheckDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CheckDocuments_Task_RequestCreditCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_RequestCreditCheck" name="Request credit check" messageRef="Message_KreditpruefungAngefordert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-credit-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_CheckDocuments_Task_RequestCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RequestCreditCheck_Task_AwaitCreditDecision</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitCreditDecision" name="Await credit decision" messageRef="Message_KreditpruefungAbgeschlossen">
      <bpmn:incoming>Flow_Task_RequestCreditCheck_Task_AwaitCreditDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AwaitCreditDecision_Gateway_DealerApproved</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_DealerApproved" name="Dealer approved?" default="Flow_Gateway_DealerApproved_Task_NotifyRejection">
      <bpmn:incoming>Flow_Task_AwaitCreditDecision_Gateway_DealerApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_DealerApproved_Task_CreateCustomerAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_DealerApproved_Task_NotifyRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateCustomerAccount" name="Create customer account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-customer-account" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_DealerApproved_Task_CreateCustomerAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CreateCustomerAccount_Task_SetUpDealerPrices</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Task_CreateCustomerAccount_DataStore_CustomerMaster">
        <bpmn:targetRef>DataStore_CustomerMaster</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetUpDealerPrices" name="Set up dealer price list">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-up-dealer-prices" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_CreateCustomerAccount_Task_SetUpDealerPrices</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SetUpDealerPrices_Task_WelcomeCall</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_WelcomeCall" name="Welcome call by key account manager">
      <bpmn:extensionElements>
        <zeebe:formDefinition externalReference="custom:welcome-call" />
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="key-account" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_SetUpDealerPrices_Task_WelcomeCall</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_WelcomeCall_End_PartnerActivated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PartnerActivated" name="Partner activated">
      <bpmn:incoming>Flow_Task_WelcomeCall_End_PartnerActivated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyRejection" name="Notify applicant of rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_DealerApproved_Task_NotifyRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_NotifyRejection_End_ApplicationRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ApplicationRejected" name="Dealer application rejected">
      <bpmn:incoming>Flow_Task_NotifyRejection_End_ApplicationRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_CustomerMaster" name="Customer master" />
    <bpmn:sequenceFlow id="Flow_Start_DealerApplicationReceived_Task_VerifyCommercialRegister" sourceRef="Start_DealerApplicationReceived" targetRef="Task_VerifyCommercialRegister" />
    <bpmn:sequenceFlow id="Flow_Task_VerifyCommercialRegister_Task_CheckDocuments" sourceRef="Task_VerifyCommercialRegister" targetRef="Task_CheckDocuments" />
    <bpmn:sequenceFlow id="Flow_Task_CheckDocuments_Task_RequestCreditCheck" sourceRef="Task_CheckDocuments" targetRef="Task_RequestCreditCheck" />
    <bpmn:sequenceFlow id="Flow_Task_RequestCreditCheck_Task_AwaitCreditDecision" sourceRef="Task_RequestCreditCheck" targetRef="Task_AwaitCreditDecision" />
    <bpmn:sequenceFlow id="Flow_Task_AwaitCreditDecision_Gateway_DealerApproved" sourceRef="Task_AwaitCreditDecision" targetRef="Gateway_DealerApproved" />
    <bpmn:sequenceFlow id="Flow_Gateway_DealerApproved_Task_CreateCustomerAccount" name="yes" sourceRef="Gateway_DealerApproved" targetRef="Task_CreateCustomerAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_DealerApproved_Task_NotifyRejection" name="no" sourceRef="Gateway_DealerApproved" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_Task_CreateCustomerAccount_Task_SetUpDealerPrices" sourceRef="Task_CreateCustomerAccount" targetRef="Task_SetUpDealerPrices" />
    <bpmn:sequenceFlow id="Flow_Task_SetUpDealerPrices_Task_WelcomeCall" sourceRef="Task_SetUpDealerPrices" targetRef="Task_WelcomeCall" />
    <bpmn:sequenceFlow id="Flow_Task_WelcomeCall_End_PartnerActivated" sourceRef="Task_WelcomeCall" targetRef="End_PartnerActivated" />
    <bpmn:sequenceFlow id="Flow_Task_NotifyRejection_End_ApplicationRejected" sourceRef="Task_NotifyRejection" targetRef="End_ApplicationRejected" />
  </bpmn:process>
  <bpmn:message id="Message_KreditpruefungAbgeschlossen" name="KreditpruefungAbgeschlossen">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=partnerId" />
    </bpmn:extensionElements>
  </bpmn:message>
