  <bpmn:collaboration id="Collaboration_logistik_shipping">
    <bpmn:participant id="Participant_Shipping" name="Nordwind Logistics – Parcel shipping" processRef="Process_Shipping" />
    <bpmn:participant id="Participant_Carrier" name="Parcel carrier" />
    <bpmn:messageFlow id="MessageFlow_Task_TransmitShippingOrder_Participant_Carrier" name="Shipping order" sourceRef="Task_TransmitShippingOrder" targetRef="Participant_Carrier" />
    <bpmn:messageFlow id="MessageFlow_Participant_Carrier_Task_AwaitPickupScan" name="Pickup scan" sourceRef="Participant_Carrier" targetRef="Task_AwaitPickupScan" />
    <bpmn:messageFlow id="MessageFlow_Participant_Carrier_Task_AwaitProofOfDelivery" name="Proof of delivery" sourceRef="Participant_Carrier" targetRef="Task_AwaitProofOfDelivery" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Shipping" name="Parcel shipping" isExecutable="true">
    <bpmn:documentation>Books a parcel carrier, hands the parcels over and tracks delivery.</bpmn:documentation>
    <bpmn:startEvent id="Start_ShipmentRequested" name="Shipment requested">
      <bpmn:outgoing>Flow_Start_ShipmentRequested_Task_DetermineCarrier</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_DetermineCarrier" name="Determine carrier and service level">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="determine-carrier" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_ShipmentRequested_Task_DetermineCarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DetermineCarrier_Task_BookShipment</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_BookShipment" name="Book shipment and create label">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="book-shipment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_DetermineCarrier_Task_BookShipment</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_BookShipment_Task_TransmitShippingOrder</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_TransmitShippingOrder" name="Transmit shipping order to carrier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transmit-shipping-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_BookShipment_Task_TransmitShippingOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_TransmitShippingOrder_Sub_CarrierHandover</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="Sub_CarrierHandover" name="Carrier handover">
      <bpmn:incoming>Flow_Task_TransmitShippingOrder_Sub_CarrierHandover</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_CarrierHandover_Event_ShipmentDispatched</bpmn:outgoing>
      <bpmn:startEvent id="Start_HandoverStarted" name="Handover started">
        <bpmn:outgoing>Flow_Start_HandoverStarted_Task_LoadParcels</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="Task_LoadParcels" name="Load parcels onto carrier truck">
        <bpmn:incoming>Flow_Start_HandoverStarted_Task_LoadParcels</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_LoadParcels_Task_AwaitPickupScan</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:receiveTask id="Task_AwaitPickupScan" name="Await pickup scan" messageRef="Message_PickupScanned">
        <bpmn:incoming>Flow_Task_LoadParcels_Task_AwaitPickupScan</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_AwaitPickupScan_End_ShipmentDispatched</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="End_ShipmentDispatched" name="Shipment dispatched">
        <bpmn:incoming>Flow_Task_AwaitPickupScan_End_ShipmentDispatched</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_HandoverStarted_Task_LoadParcels" sourceRef="Start_HandoverStarted" targetRef="Task_LoadParcels" />
      <bpmn:sequenceFlow id="Flow_Task_LoadParcels_Task_AwaitPickupScan" sourceRef="Task_LoadParcels" targetRef="Task_AwaitPickupScan" />
      <bpmn:sequenceFlow id="Flow_Task_AwaitPickupScan_End_ShipmentDispatched" sourceRef="Task_AwaitPickupScan" targetRef="End_ShipmentDispatched" />
    </bpmn:subProcess>
    <bpmn:intermediateThrowEvent id="Event_ShipmentDispatched" name="Shipment dispatched">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shipment-dispatched" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Sub_CarrierHandover_Event_ShipmentDispatched</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_ShipmentDispatched_Task_AwaitProofOfDelivery</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_ShipmentDispatched_ed" messageRef="Message_LieferungVersendet" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="Task_AwaitProofOfDelivery" name="Await proof of delivery" messageRef="Message_ProofOfDelivery">
      <bpmn:incoming>Flow_Event_ShipmentDispatched_Task_AwaitProofOfDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AwaitProofOfDelivery_End_ShipmentDelivered</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_DeliveryOverdue" name="Delivery overdue by 3 days" cancelActivity="false" attachedToRef="Task_AwaitProofOfDelivery">
      <bpmn:outgoing>Flow_Boundary_DeliveryOverdue_Event_DeliveryDelayed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_DeliveryOverdue_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_ShipmentDelivered" name="Shipment delivered">
      <bpmn:incoming>Flow_Task_AwaitProofOfDelivery_End_ShipmentDelivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_DeliveryDelayed" name="Delivery delayed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="delivery-delayed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Boundary_DeliveryOverdue_Event_DeliveryDelayed</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_DeliveryDelayed_End_DelayReported</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_DeliveryDelayed_ed" messageRef="Message_LieferungVerspaetet" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_DelayReported" name="Delay reported">
      <bpmn:incoming>Flow_Event_DeliveryDelayed_End_DelayReported</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ShipmentRequested_Task_DetermineCarrier" sourceRef="Start_ShipmentRequested" targetRef="Task_DetermineCarrier" />
    <bpmn:sequenceFlow id="Flow_Task_DetermineCarrier_Task_BookShipment" sourceRef="Task_DetermineCarrier" targetRef="Task_BookShipment" />
