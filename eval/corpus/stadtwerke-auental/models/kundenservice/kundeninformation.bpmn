  <bpmn:process id="Process_Stoerungsinformation" name="Störungsinformation" isExecutable="true">
    <bpmn:documentation>Veröffentlicht bei einer Großstörung Informationen auf Website, App und Störungshotline und gibt Entwarnung, sobald die Störung beendet ist.</bpmn:documentation>
