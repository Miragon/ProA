#!/bin/bash
#
# Fast pre-commit checks (< 15s): lint & format only.
# Full tests run on pre-push and in CI.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

# --- Frontend: ESLint + Prettier on staged files -----------------------------
FRONTEND_STAGED="$(echo "$STAGED_FILES" | grep '^frontend/' | grep -E '\.(ts|tsx|js|vue|scss|css|json)$' || true)"

if [ -n "$FRONTEND_STAGED" ]; then
  echo "[pre-commit] Checking frontend lint & format..."
  cd "$REPO_ROOT/frontend"

  # Strip the leading "frontend/" so paths are relative to the frontend dir
  RELATIVE_FILES="$(echo "$FRONTEND_STAGED" | sed 's|^frontend/||')"

  LINTABLE="$(echo "$RELATIVE_FILES" | grep -E '\.(ts|tsx|js|vue)$' || true)"
  if [ -n "$LINTABLE" ]; then
    # shellcheck disable=SC2086
    yarn --silent eslint $LINTABLE || {
      echo "[pre-commit] ESLint failed. Fix the issues or run 'yarn lint' to auto-fix." >&2
      exit 1
    }
  fi

  # shellcheck disable=SC2086
  yarn --silent prettier --check $RELATIVE_FILES || {
    echo "[pre-commit] Prettier check failed. Run 'yarn format' to fix." >&2
    exit 1
  }
  cd "$REPO_ROOT"
fi

echo "[pre-commit] OK"
