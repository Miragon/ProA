#!/bin/bash
#
# Pre-push safety net: run the test suites for the parts that changed
# compared to the remote tracking branch (falls back to running everything).
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
if [ -n "$UPSTREAM" ]; then
  CHANGED_FILES="$(git diff --name-only "$UPSTREAM"...HEAD)"
else
  # New branch without upstream: check everything that differs from develop
  CHANGED_FILES="$(git diff --name-only origin/develop...HEAD 2>/dev/null || echo 'backend/ frontend/')"
fi

BACKEND_CHANGED="$(echo "$CHANGED_FILES" | grep -E '^(backend/|pom\.xml)' || true)"
FRONTEND_CHANGED="$(echo "$CHANGED_FILES" | grep '^frontend/' || true)"

if [ -n "$BACKEND_CHANGED" ]; then
  echo "[pre-push] Backend changed - running tests..."
  cd "$REPO_ROOT/backend"
  ./mvnw --quiet verify || {
    echo "[pre-push] Backend tests failed - push aborted." >&2
    exit 1
  }
  cd "$REPO_ROOT"

  if [ -f "$REPO_ROOT/backend/target/jacoco-report/jacoco.xml" ] && command -v xmllint >/dev/null; then
    REPORT="$REPO_ROOT/backend/target/jacoco-report/jacoco.xml"
    COVERED=$(xmllint --xpath "sum(//counter[@type='INSTRUCTION' and not(ancestor::package)]/@covered)" "$REPORT")
    MISSED=$(xmllint --xpath "sum(//counter[@type='INSTRUCTION' and not(ancestor::package)]/@missed)" "$REPORT")
    COVERAGE=$(echo "scale=1; $COVERED / ($COVERED + $MISSED) * 100" | bc)
    echo "[pre-push] Backend instruction coverage: $COVERAGE%"
  fi
fi

if [ -n "$FRONTEND_CHANGED" ]; then
  echo "[pre-push] Frontend changed - running lint, type-check & build..."
  cd "$REPO_ROOT/frontend"
  yarn --silent eslint . --ignore-path .gitignore || {
    echo "[pre-push] ESLint failed - push aborted." >&2
    exit 1
  }
  yarn --silent build || {
    echo "[pre-push] Frontend build (incl. type-check) failed - push aborted." >&2
    exit 1
  }
  cd "$REPO_ROOT"
fi

echo "[pre-push] OK"
