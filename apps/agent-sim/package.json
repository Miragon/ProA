{
  "name": "@proa/agent-sim",
  "version": "0.0.0",
  "private": true,
  "description": "LLM-free simulation agent: works the ProA analysis pipeline over MCP with a deterministic policy and records its submissions for eval:replay",
  "type": "module",
  "bin": {
    "proa-agent-sim": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "sim": "node src/main.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@proa/contracts": "workspace:0.0.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  }
}
