{
  "name": "@proa/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The proa command: seed and import models, agent tokens, status and the MCP stdio bridge",
  "type": "module",
  "bin": {
    "proa": "./src/main.ts"
  },
  "exports": {
    ".": "./src/program.ts"
  },
  "scripts": {
    "proa": "node src/main.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:live": "vitest run --project live"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@proa/client": "workspace:0.0.0",
    "@proa/contracts": "workspace:0.0.0",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
