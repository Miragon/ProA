            "type": "string",
            "maxLength": 456,
            "pattern": "^([a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*)#([A-Z_a-z\\u00C0-\\u00D6\\u00D8-\\u00F6\\u00F8-\\u02FF\\u0370-\\u037D\\u037F-\\u1FFF\\u200C-\\u200D\\u2070-\\u218F\\u2C00-\\u2FEF\\u3001-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFFD][A-Z_a-z\\u00C0-\\u00D6\\u00D8-\\u00F6\\u00F8-\\u02FF\\u0370-\\u037D\\u037F-\\u1FFF\\u200C-\\u200D\\u2070-\\u218F\\u2C00-\\u2FEF\\u3001-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFFD\\-.0-9\\u00B7\\u0300-\\u036F\\u203F-\\u2040]*)$",
            "description": "Reference to a BPMN element: `<model_key>#<element_id>`, or `<model_key>#<process_id>` for a process.",
            "example": "vertrieb/auftragsabwicklung#Event_WareVersandbereit"
          },
          "RelationStatus": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "held",
              "obsolete"
            ],
            "description": "Review status of a relation."
          },
          "EndpointState": {
            "type": "string",
            "enum": [
              "ok",
              "changed",
              "missing"
            ],
            "description": "State of the relation endpoints in the head revisions."
          },
          "Tier": {
            "type": "string",
            "enum": [
              "key",
              "lexical",
              "semantic",
              "manual",
              "rule"
            ],
            "description": "Evidence tier of a relation."
          },
          "Timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "RFC 3339 timestamp (UTC).",
            "example": "2026-10-06T12:00:00.000Z"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
