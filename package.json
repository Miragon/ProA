{
  "name": "proa",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "ProA 2.0: a headless store for process landscapes (CONCEPT: docs/proa-2/CONCEPT.md)",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:candidates": "pnpm --filter @proa/eval-tools candidates",
    "dev": "pnpm --parallel --filter @proa/server --filter @proa/web dev",
    "docker:up": "docker compose -p proa2 -f docker/compose.yaml up -d --build --wait",
    "db:up": "docker compose -p proa2 -f docker/compose.yaml up -d --wait db",
    "db:down": "docker compose -p proa2 -f docker/compose.yaml down",
    "db:migrate": "pnpm --filter @proa/server db:migrate",
    "seed": "node apps/cli/src/main.ts seed",
    "proa": "node apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
